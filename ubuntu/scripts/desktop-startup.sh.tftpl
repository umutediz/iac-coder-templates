set -eu

if [ ! -f "$HOME/.bashrc" ]; then
  cp -r /etc/skel/. "$HOME/" 2>/dev/null || true
fi

settings_dir="$HOME/.local/share/code-server/User"
settings_file="$settings_dir/settings.json"
mkdir -p "$settings_dir"

if ! grep -q '"workbench.colorTheme"' "$settings_file" 2>/dev/null; then
  if [ ! -s "$settings_file" ] || [ "$(tr -d '[:space:]' < "$settings_file" 2>/dev/null)" = "{}" ]; then
    cat > "$settings_file" <<'EOF'
{
  "workbench.colorTheme": "Default Dark Modern"
}
EOF
  else
    tmp_settings="$(mktemp)"
    awk '
      {
        lines[NR] = $0
      }
      END {
        end = 0
        for (i = NR; i >= 1; i--) {
          if (lines[i] ~ /^[[:space:]]*}[[:space:]]*$/) {
            end = i
            break
          }
        }
        if (end == 0) {
          print "{"
          print "  \"workbench.colorTheme\": \"Default Dark Modern\""
          print "}"
          exit
        }
        last = 0
        for (i = end - 1; i >= 1; i--) {
          if (lines[i] !~ /^[[:space:]]*$/) {
            last = i
            break
          }
        }
        for (i = 1; i <= NR; i++) {
          if (i == last && lines[i] !~ /,[[:space:]]*$/) {
            print lines[i] ","
          } else if (i == end) {
            print "  \"workbench.colorTheme\": \"Default Dark Modern\""
            print lines[i]
          } else {
            print lines[i]
          }
        }
      }
    ' "$settings_file" > "$tmp_settings" && mv "$tmp_settings" "$settings_file"
  fi
fi

export DISPLAY=:1

${desktop_settings}
${desktop_pre_start}

mkdir -p /tmp/.X11-unix /tmp/.ICE-unix
chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix

mkdir -p "$HOME/.vnc"
touch "$HOME/.Xauthority"

cat > "$HOME/.vnc/xstartup" <<'EOF'
${vnc_xstartup}
EOF
chmod +x "$HOME/.vnc/xstartup"

cat > "$HOME/.vnc/config" <<'EOF'
${vnc_config}
EOF

vncserver -kill :1 2>/dev/null || true
pkill -x websockify 2>/dev/null || true
nginx -s stop -c /tmp/novnc-coder/nginx.conf 2>/dev/null || true

rm -f /tmp/.X1-lock /tmp/.X11-unix/X1 2>/dev/null || true
rm -f /tmp/novnc-nginx.pid 2>/dev/null || true

vncserver :1 -SecurityTypes None -localhost yes

websockify \
  --daemon \
  --log-file=/tmp/websockify.log \
  127.0.0.1:6080 127.0.0.1:5901

mkdir -p /tmp/novnc-coder
mkdir -p /tmp/novnc-nginx-client-body
mkdir -p /tmp/novnc-nginx-proxy
mkdir -p /tmp/novnc-nginx-fastcgi
mkdir -p /tmp/novnc-nginx-uwsgi
mkdir -p /tmp/novnc-nginx-scgi

cat > /tmp/novnc-coder/index.html <<'EOF'
${novnc_index_html}
EOF

cat > /tmp/novnc-coder/nginx.conf <<'EOF'
${novnc_nginx_conf}
EOF

if ! command -v nginx >/dev/null 2>&1; then
  echo "ERROR: nginx is not installed. Add nginx-light to the GUI package list." >&2
  exit 1
fi

nginx -t -c /tmp/novnc-coder/nginx.conf
nginx -c /tmp/novnc-coder/nginx.conf -g 'daemon on;'

echo "Desktop startup complete."
echo "VNC:        127.0.0.1:5901"
echo "websockify: 127.0.0.1:6080"
echo "noVNC:      127.0.0.1:6081"
